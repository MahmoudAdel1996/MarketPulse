# Copy to .env at the repo root. MarketPulse.Api loads it automatically on startup
# (development convenience only — never committed; see README.md).

# PostgreSQL used by MarketPulse.Api (see ConnectionStrings:Postgres in appsettings.Development.json)
POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=marketpulse

# InfluxDB 3 Core admin token (price history). Core has no username/password — this token is the credential.
# Used by the influxdb3 container (preconfigured admin token) and by MarketPulse.Api as InfluxDb:Token.
# Generate one with:  echo "apiv3_$(openssl rand -base64 32 | tr -d '=+/')"
INFLUXDB__TOKEN=

# Google OAuth client, created in Google Cloud Console.
# Authorized redirect URI must be: http://localhost:5000/signin-google (adjust host/port per environment)
AUTHENTICATION__GOOGLE__CLIENTID=
AUTHENTICATION__GOOGLE__CLIENTSECRET=
